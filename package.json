{
  "name": "tsh-ppe-vercel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:assets": "node scripts/build-frontend-assets.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build:frontend": "npm run build:assets && npm run build:styles",
    "predev": "npm run build:frontend",
    "dev": "next dev",
    "prebuild": "npm run build:frontend",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:static",
    "test:static": "node scripts/run-static-tests.mjs",
    "test:browser": "node scripts/production-browser-qa.mjs && node scripts/accessibility-browser-qa.mjs && node scripts/critical-flows-browser-qa.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "release:gate": "node scripts/release-gate.mjs",
    "test:notifications": "node --no-warnings scripts/run-notification-tests.mjs",
    "test:notifications:live": "node --no-warnings scripts/live-flex-smoke.mjs --confirm-live"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/sarabun": "^5.1.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "browserslist": "^4.29.3",
    "caniuse-lite": "^1.0.30001816",
    "chart.js": "^4.4.7",
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.17"
  }
}
